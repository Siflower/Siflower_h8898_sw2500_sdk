/dts-v1/;
#include "sf21h8898-siflower-one.dtsi"


/ {
	model = "Siflower One (Booting from NOR & wifi)";
	compatible = "siflower,one-nor-wifi", "siflower,melit", "siflower,sf21h8898";

	aliases {
		spi0 = &spi0;
	};
};

&spi0 {
	status = "okay";
	num-cs = <3>;
	cs-gpios = <&gpio 5 GPIO_ACTIVE_LOW>, <&gpio 19 GPIO_ACTIVE_LOW>,
	            <&gpio 0 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <35000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

	        partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0 0x90000>;
				read-only;
			};

			factory: partition@90000 {
				label = "factory";
				reg = <0x90000 0x10000>;
			};

			partition@a0000 {
				label = "firmware";
				reg = <0xa0000 0x0>;
				compatible = "denx,fit";
			};
		};
	};

	/* ---- 底板 QJ32F108 MCU：用户态 /dev/spidev0.1 访问 ----
	 * reg = <1> 对应上面 cs-gpios 的第 2 项（gpio19）
	 * compatible 必须用 spidev 白名单里的占位串，否则不会绑定 spidev
	 */
	spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		spi-max-frequency = <1000000>;	/* 先 1MHz 跑通，再按 MCU 手册提频 */
		/* 按 QJ32F108 时序需要时再打开下面两行之一：
		 *	spi-cpha;  spi-cpol;       mode 1~3
		 *	spi-cs-high;               高有效片选
		 */
	};

	/* ---- 底板 FPGA：用户态 /dev/spidev0.2 访问 ----
	 * reg = <2> 对应上面 cs-gpios 的第 3 项（gpio0）
	 * compatible 必须用 spidev 白名单里的占位串，否则不会绑定 spidev
	 */
	spidev@2 {
		compatible = "rohm,dh2228fv";
		reg = <2>;
		spi-max-frequency = <1000000>;	/* 先 1MHz 跑通，再按 FPGA 手册提频 */
		/* 按 FPGA 时序需要时再打开下面两行之一：
		 *	spi-cpha;  spi-cpol;       mode 1~3
		 *	spi-cs-high;               高有效片选
		 */
	};
};

&pcie0 {
        reset-gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
        reset-ms = <100>;
        num-lanes = <1>;
        lane-mode = <0>;
        status = "okay";
        pcie@0,0 {
                reg = <0x0000 0 0 0 0>;
                #address-cells = <3>;
                #size-cells = <2>;

                wifi@0,0 {
                        reg = <0x0 0 0 0 0>;
                        nvmem-cells = <&mtd_mac_address>, <&mtd_wifi_version>, <&mtd_wifi_info>, <&mtd_rssi_offset>, <&mtd_refpower>, <&mtd_calipower>;
                        nvmem-cell-names = "mac-address", "wifi-version", "wifi-info", "rssi-offset", "refpower", "calipower";
                        mac-address-increment = <2>;
                };

                wifi@0,1 {
                        reg = <0x100 0 0 0 0>;
                        nvmem-cells = <&mtd_mac_address>, <&mtd_wifi_version>, <&mtd_wifi_info>, <&mtd_rssi_offset>, <&mtd_refpower>, <&mtd_calipower>;
                        nvmem-cell-names = "mac-address", "wifi-version", "wifi-info", "rssi-offset", "refpower", "calipower";
                        mac-address-increment = <6>;
                };
        };
};

&uart0 {
    status = "okay";
};

&i2c0 {
    status = "okay";
    /delete-node/ rtc@51;
};

&i2c1 {
    status = "okay";
};

&leds {
    status = "disabled";
};

&pwm1 {
    status = "okay";
};

&{/keys/reset} {
    gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
};

&usb_vbus {
	/delete-property/ gpio;
	/delete-property/ enable-active-high;
};

&iomux {
    rstbtn_pin: rstbtn_pin {
        pinctrl-single,pins = <CLK_OUT GPIO_MODE>;
        pinctrl-single,bias-pullup = <SW_PU SW_PU 0 SW_PU>;
        pinctrl-single,bias-pulldown = <0 SW_PD 0 SW_PD>;
    };
};

&xgmac4 {
    status = "okay";
    nvmem-cells = <&mtd_mac_address>;
    nvmem-cell-names = "mac-address";
    mac-address-increment = <1>;
    phy-mode = "1000base-x";
	sfp-external-control;
	pinctrl-names = "default";
	pinctrl-0 = <&mac4_mdio_pins>;
    /delete-property/ phy-handle;

    fixed-link {
        speed = <1000>;
        full-duplex;
		pause;
		asym-pause;
    };
};

&mdio0 {
    /delete-property/ reset-gpios;
    /delete-property/ reset-assert-us;
    /delete-property/ reset-deassert-us;
    /delete-node/ ethernet-phy@7;

    sfphy0: ethernet-phy@1 {
        compatible = "ethernet-phy-idadb4.0411";
        reg = <0x1>;
		reset-gpios = <&gpio 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
    };
};

&mdio1 {
	ctcphy: ethernet-phy@0 {
		compatible = "ethernet-phy-id0078.2013";
		reg = <0x0>;
	};
};

&xgmac5 {
	status = "okay";
	tx-internal-delay-ps = <2793>;
	rx-internal-delay-ps = <1372>;
	phy-handle = <&ctcphy>;
	nvmem-cells = <&mtd_mac_address>;
	nvmem-cell-names = "mac-address";
	sfp-external-control;
};

#include "sf21h8898-factory.dtsi"
